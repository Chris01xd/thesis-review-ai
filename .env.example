# ThesisReview AI — Variables de entorno (copia como .env y completa los valores)

# ── Modelos de lenguaje ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Integraciones bibliográficas ─────────────────────────────────────────────
CROSSREF_ENABLED=true

# ── Integración ORCID ────────────────────────────────────────────────────────
ORCID_ENABLED=true

# ── Detección de plagio externa ──────────────────────────────────────────────
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=

# ── Seguridad ────────────────────────────────────────────────────────────────
APP_SECRET=cambiar-por-cadena-aleatoria-segura-minimo-32-caracteres

# ── Límites de carga ─────────────────────────────────────────────────────────
MAX_FILE_MB=20

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PATH=data/thesis_review.db
